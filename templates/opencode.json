        }
      }
    },
    "llm2": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llm2",
      "options": {
        "baseURL": "https://LLM2-HOST/v1",
        "apiKey": "LLM2-TOKEN"
      },
      "models": {
        "LLM2-MODEL": {
          "name": "LLM2-MODEL",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    }
  },
  "model": "llm1/LLM1-MODEL"
}
