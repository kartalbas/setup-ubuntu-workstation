{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "SERVER": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SERVER",
      "options": {
        "baseURL": "https://SERVER-HOST/v1",
        "apiKey": "SERVER-TOKEN"
      },
      "models": {
        "SERVER-MODEL": {
          "name": "SERVER-MODEL",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    }
  },
  "model": "SERVER/SERVER-MODEL"
}
