{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llm1": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llm1",
      "options": {
        "baseURL": "https://LLM1-HOST/v1",
        "apiKey": "LLM1-TOKEN"
      },
      "models": {
        "LLM1-MODEL": {
          "name": "LLM1-MODEL",
          "limit": {
            "context": 131072,
